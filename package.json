{
  "name": "kaderisasi-migrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "node ace build",
    "test": "node --test tests/*.test.mjs",
    "migrate": "node ace migration:run",
    "migration:status": "node ace migration:status",
    "seed": "node ace db:seed",
    "rbac:preflight": "node ace rbac:preflight",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#models/*": "./database/models/*.js",
    "#services/*": "./database/support/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#constants/*": "./database/constants/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.1.1",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^1.4.1",
    "@swc/core": "^1.13.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.2.0",
    "eslint": "^9.32.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "ts-node-maintained": "^10.9.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@adonisjs/core": "^6.21.0",
    "@adonisjs/lucid": "^21.8.0",
    "csvtojson": "^2.0.10",
    "luxon": "^3.7.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2"
  },
  "prettier": "@adonisjs/prettier-config",
  "description": "Shared PostgreSQL migrations, seeders, and RBAC preflight for Kaderisasi"
}
